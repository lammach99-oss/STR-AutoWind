{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "SLA: restore",
      "type": "process",
      "command": "dotnet",
      "args": ["restore", "${workspaceFolder}/StructuralLoadAssistant.sln", "--locked-mode", "-m:1", "-nr:false"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "SLA: build",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "${workspaceFolder}/StructuralLoadAssistant.sln", "--configuration", "Debug", "--no-restore", "-m:1", "-nr:false"],
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": "SLA: restore",
      "dependsOrder": "sequence",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "SLA: test",
      "type": "process",
      "command": "dotnet",
      "args": ["test", "${workspaceFolder}/tests/StructuralLoadAssistant.Tests/StructuralLoadAssistant.Tests.csproj", "--configuration", "Debug", "--no-build", "--no-restore", "-m:1", "-nr:false"],
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": "SLA: build",
      "dependsOrder": "sequence",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "SLA: run WPF",
      "type": "process",
      "command": "dotnet",
      "args": ["run", "--project", "${workspaceFolder}/src/StructuralLoadAssistant.App.Wpf/StructuralLoadAssistant.App.Wpf.csproj", "--configuration", "Debug", "--no-build", "--no-restore", "--no-launch-profile"],
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": "SLA: build",
      "dependsOrder": "sequence",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "SLA: smoke WPF",
      "type": "process",
      "command": "dotnet",
      "args": ["run", "--project", "${workspaceFolder}/src/StructuralLoadAssistant.App.Wpf/StructuralLoadAssistant.App.Wpf.csproj", "--configuration", "Debug", "--no-build", "--no-restore", "--no-launch-profile", "--", "--smoke", "--smoke-output", "${workspaceFolder}/artifacts/vscode-smoke"],
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": "SLA: build",
      "dependsOrder": "sequence",
      "problemMatcher": "$msCompile"
    }
  ]
}
